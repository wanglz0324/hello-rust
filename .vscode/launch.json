{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug: rust-hello",
            "cargo": {
                "args": ["build", "--bin=rust-hello", "--package=rust-hello"],
                "filter": {
                    "name": "rust-hello",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug: unit tests",
            "cargo": {
                "args": ["test", "--no-run", "--bin=rust-hello", "--package=rust-hello"],
                "filter": {
                    "name": "rust-hello",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
